[{"op": "set", "collection": "dash", "doc_id": "meta", "data": {"title": "TORS Get-Whole Scorecard"}}, {"op": "set", "collection": "datasets", "doc_id": "sales_weekly", "data": {"title": "Sales by week", "description": "Invoices and cash sales less credit memos, by Monday-start week since Aug 31, 2026; is_current marks the week in progress. Reads NetSuite transactions.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT TO_CHAR(TRUNC(t.trandate,'IW'),'YYYY-MM-DD') AS week, SUM(t.foreigntotal) AS sales, SUM(CASE WHEN t.type IN ('CustInvc','CashSale') THEN 1 ELSE 0 END) AS invoices, MAX(CASE WHEN TRUNC(t.trandate,'IW') = TRUNC(CURRENT_DATE,'IW') THEN 1 ELSE 0 END) AS is_current FROM transaction t WHERE t.type IN ('CustInvc','CashSale','CustCred') AND t.trandate >= TO_DATE('2026-08-31','YYYY-MM-DD') AND t.trandate <= CURRENT_DATE GROUP BY TO_CHAR(TRUNC(t.trandate,'IW'),'YYYY-MM-DD') ORDER BY week", "description": "Sales by week"}}}}, {"op": "set", "collection": "datasets", "doc_id": "quotes_weekly", "data": {"title": "Quotes by week", "description": "NetSuite estimates by week since Aug 31, 2026, with won (processed), lost or expired, still open, and win rate on decided quotes. Reads NetSuite transactions.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT TO_CHAR(TRUNC(t.trandate,'IW'),'YYYY-MM-DD') AS week, COUNT(*) AS quotes, ABS(SUM(t.foreigntotal)) AS quote_value, SUM(CASE WHEN t.status='B' THEN 1 ELSE 0 END) AS won, SUM(CASE WHEN t.status IN ('C','X') THEN 1 ELSE 0 END) AS lost, SUM(CASE WHEN t.status='A' THEN 1 ELSE 0 END) AS still_open, CASE WHEN SUM(CASE WHEN t.status IN ('B','C','X') THEN 1 ELSE 0 END) > 0 THEN SUM(CASE WHEN t.status='B' THEN 1 ELSE 0 END) / SUM(CASE WHEN t.status IN ('B','C','X') THEN 1 ELSE 0 END) ELSE NULL END AS win_rate FROM transaction t WHERE t.type='Estimate' AND t.trandate >= TO_DATE('2026-08-31','YYYY-MM-DD') AND t.trandate <= CURRENT_DATE GROUP BY TO_CHAR(TRUNC(t.trandate,'IW'),'YYYY-MM-DD') ORDER BY week", "description": "Quotes by week"}}}}, {"op": "set", "collection": "datasets", "doc_id": "cash_cards", "data": {"title": "Cash and credit cards", "description": "Operating bank balances (excluding the GM Financial loan set up as a bank account) and what's owed on the MC and Amex cards. Reads NetSuite account balances.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT SUM(CASE WHEN a.accttype='Bank' AND a.acctnumber <> '26650' THEN a.balance ELSE 0 END) AS cash, -SUM(CASE WHEN a.acctnumber IN ('22200','22340','22500') THEN a.balance ELSE 0 END) AS cards FROM account a WHERE a.isinactive='F' AND a.accttype IN ('Bank','CredCard')", "description": "Cash and credit cards"}}}}, {"op": "set", "collection": "datasets", "doc_id": "ap_status", "data": {"title": "Vendor bills owed", "description": "Open vendor bills: total, past due, and more than 15 days past due. Reads NetSuite vendor bills.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT COUNT(*) AS open_bills, SUM(t.foreignamountunpaid) AS open_ap, SUM(CASE WHEN t.duedate < CURRENT_DATE THEN t.foreignamountunpaid ELSE 0 END) AS past_due, SUM(CASE WHEN t.duedate < CURRENT_DATE - 15 THEN t.foreignamountunpaid ELSE 0 END) AS over15 FROM transaction t WHERE t.type='VendBill' AND t.foreignamountunpaid > 0", "description": "Vendor bills owed"}}}}, {"op": "set", "collection": "datasets", "doc_id": "pos_weekly", "data": {"title": "Purchase orders by week", "description": "Purchase orders written per week since Aug 31, 2026, count and dollars. Reads NetSuite purchase orders.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT TO_CHAR(TRUNC(t.trandate,'IW'),'YYYY-MM-DD') AS week, COUNT(*) AS pos, ABS(SUM(t.foreigntotal)) AS po_value FROM transaction t WHERE t.type='PurchOrd' AND t.trandate >= TO_DATE('2026-08-31','YYYY-MM-DD') AND t.trandate <= CURRENT_DATE GROUP BY TO_CHAR(TRUNC(t.trandate,'IW'),'YYYY-MM-DD') ORDER BY week", "description": "Purchase orders by week"}}}}, {"op": "set", "collection": "datasets", "doc_id": "open_pos_vendor", "data": {"title": "Open POs by vendor", "description": "Dollars ordered but not yet received on open purchase orders (pending approval, pending receipt, partially received), by vendor. Reads NetSuite purchase order lines.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT BUILTIN.DF(t.entity) AS vendor, COUNT(DISTINCT t.id) AS pos, SUM((tl.quantity - NVL(tl.quantityshiprecv,0)) * tl.rate) AS open_value FROM transaction t JOIN transactionline tl ON tl.transaction=t.id WHERE t.type='PurchOrd' AND t.status IN ('A','B','D','E') AND tl.mainline='F' AND tl.itemtype IS NOT NULL AND tl.quantity > NVL(tl.quantityshiprecv,0) GROUP BY BUILTIN.DF(t.entity) ORDER BY open_value DESC", "description": "Open POs by vendor"}}}}, {"op": "set", "collection": "datasets", "doc_id": "costs_weekly", "data": {"title": "Freight, late fees, software", "description": "Weekly shipping income (40080, 40085) vs. carrier cost (67000, 67005, 71416 fuel), late fees and interest (71920), and software (66910) since Aug 31, 2026. Reads NetSuite posted accounting lines.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT TO_CHAR(TRUNC(t.trandate,'IW'),'YYYY-MM-DD') AS week, SUM(CASE WHEN a.acctnumber IN ('40080','40085') THEN -tal.amount ELSE 0 END) AS freight_billed, SUM(CASE WHEN a.acctnumber IN ('67000','67005','71416') THEN tal.amount ELSE 0 END) AS freight_cost, SUM(CASE WHEN a.acctnumber='71920' THEN tal.amount ELSE 0 END) AS late_fees, SUM(CASE WHEN a.acctnumber='66910' THEN tal.amount ELSE 0 END) AS software FROM transactionaccountingline tal JOIN transaction t ON t.id=tal.transaction JOIN account a ON a.id=tal.account WHERE tal.posting='T' AND t.trandate >= TO_DATE('2026-08-31','YYYY-MM-DD') AND t.trandate <= CURRENT_DATE AND a.acctnumber IN ('40080','40085','67000','67005','71416','71920','66910') GROUP BY TO_CHAR(TRUNC(t.trandate,'IW'),'YYYY-MM-DD') ORDER BY week", "description": "Freight, late fees, software"}}}}, {"op": "set", "collection": "datasets", "doc_id": "backorders", "data": {"title": "Items on backorder", "description": "Count of items with customer backorders at the main warehouse. Reads NetSuite item location quantities.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT COUNT(*) AS items_backordered, SUM(il.quantitybackordered) AS units_backordered FROM aggregateitemlocation il WHERE il.location=1 AND il.quantitybackordered > 0", "description": "Items on backorder"}}}}, {"op": "set", "collection": "datasets", "doc_id": "dead_stock", "data": {"title": "Dead stock", "description": "Inventory items on hand with no invoiced sales in the last 12 months: SKU count and value at cost, plus total inventory value. Reads NetSuite items and invoice lines.", "source": {"kind": "query", "connector": "NetSuite", "tool": "ns_runCustomSuiteQL", "args": {"sqlQuery": "SELECT SUM(CASE WHEN s.item IS NULL THEN 1 ELSE 0 END) AS dead_skus, SUM(CASE WHEN s.item IS NULL THEN i.totalvalue ELSE 0 END) AS dead_value, SUM(i.totalvalue) AS total_value, COUNT(*) AS skus FROM item i LEFT JOIN (SELECT DISTINCT tl.item FROM transactionline tl JOIN transaction t ON t.id=tl.transaction WHERE t.type='CustInvc' AND t.trandate >= ADD_MONTHS(CURRENT_DATE,-12)) s ON s.item=i.id WHERE i.itemtype='InvtPart' AND i.totalquantityonhand > 0", "description": "Dead stock"}}}}, {"op": "set", "collection": "files", "doc_id": "index.html", "data": {"text": "<style>\n.sc { display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); }\n.sc-head { display: grid; gap: var(--cds-gap-xs); }\n.sc-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.sc-take { margin: 0; font-size: var(--cds-font-size-body); max-width: 70ch; }\n.sc-goal { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); max-width: 75ch; }\n.sc-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: var(--cds-gap-md); }\n.sc-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md) var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; min-width: 0; }\n.sc-tile-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.sc-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; line-height: 1.15; min-height: 1.15em; }\n.sc-tile-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.sc-pill { display: inline-block; font-size: var(--cds-font-size-caption); padding: 0 var(--cds-pad-xs); border-radius: 999px; border: 1px solid currentColor; justify-self: start; }\n.sc-pill:empty { display: none; }\n.sc-ok { color: var(--color-ok); } .sc-warn { color: var(--color-warn); } .sc-bad { color: var(--color-bad); }\n.sc-sec { display: grid; gap: var(--cds-gap-md); }\n.sc-sec-h { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n.sc-sec-h span { color: var(--color-fg-muted); font-weight: 400; }\n.sc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--cds-gap-md); }\n.sc-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); align-content: start; min-width: 0; }\n.sc-card h3 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n.sc-note { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.sc-chart { position: relative; min-height: 220px; }\n.sc-chart svg text { fill: var(--color-fg-muted); font-size: 11px; font-family: var(--font-anthropic-sans); }\n.sc-chart .tl { fill: var(--color-fg); }\n.sc-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; font-variant-numeric: tabular-nums; z-index: 2; }\n.sc-tip .d { color: var(--cds-text-secondary); }\n.sc-sw { display: inline-block; width: .6rem; height: .6rem; border-radius: 2px; margin-right: .3rem; vertical-align: baseline; }\n.sc-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.sc-stats { display: flex; flex-wrap: wrap; gap: var(--cds-gap-lg); }\n.sc-stat { display: grid; gap: 2px; }\n.sc-stat b { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-heading); font-variant-numeric: tabular-nums; }\n.sc-stat span { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.sc-tablebox { max-height: 22rem; overflow: auto; }\n.sc-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.sc-table th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); }\n.sc-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); }\n.sc-table .num { text-align: right; }\n.sc-bar { height: .5rem; border-radius: 999px; background: var(--cds-chart-muted); min-width: 2px; }\n.sc-manual { margin: 0; padding-left: 1.1rem; display: grid; gap: var(--cds-gap-xs); font-size: var(--cds-font-size-body); }\n.sc-fail { display: flex; align-items: center; justify-content: center; gap: .4rem; min-height: inherit; height: 100%; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.sc-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"sc\">\n  <header class=\"sc-head\">\n    <h1 class=\"sc-title\" id=\"top\">TORS Get-Whole Scorecard</h1>\n    <p class=\"sc-take\" id=\"take\">Last full week's sales were <b class=\"dash-skeleton\" data-source=\"sales_status\" data-field=\"last_sales\" data-row=\"0\">\u2014</b>, <b class=\"dash-skeleton\" data-source=\"sales_status\" data-field=\"last_gap\" data-row=\"0\">\u2014</b> against the $97K weekly target. Bills more than 15 days late: <b class=\"dash-skeleton\" data-source=\"ap_status\" data-field=\"over15\" data-row=\"0\">\u2014</b>.</p>\n    <p class=\"sc-goal\">Goal: be whole by February 1. That means $97K a week in sales, no bill more than 15 days past due, payroll first, no new stock buys except against a customer order, and TORS cash stays in TORS.</p>\n  </header>\n\n  <section class=\"sc-tiles\" id=\"tiles\">\n    <div class=\"sc-tile\">\n      <span class=\"sc-tile-label\">This week so far</span>\n      <span class=\"sc-big dash-skeleton\" id=\"t-cur\" data-source=\"sales_status\" data-field=\"cur_sales\" data-row=\"0\">\u2014</span>\n      <span class=\"sc-tile-note\">Target $97K a week</span>\n    </div>\n    <div class=\"sc-tile\">\n      <span class=\"sc-tile-label\">Last full week</span>\n      <span class=\"sc-big dash-skeleton\" id=\"t-last\" data-source=\"sales_status\" data-field=\"last_sales\" data-row=\"0\">\u2014</span>\n      <span class=\"sc-pill\" id=\"p-last\"></span>\n    </div>\n    <div class=\"sc-tile\">\n      <span class=\"sc-tile-label\">Cash in the bank</span>\n      <span class=\"sc-big dash-skeleton\" id=\"t-cash\" data-source=\"cash_cards\" data-field=\"cash\" data-row=\"0\">\u2014</span>\n      <span class=\"sc-tile-note\">As booked in NetSuite. Floor $40K</span>\n      <span class=\"sc-pill\" id=\"p-cash\"></span>\n    </div>\n    <div class=\"sc-tile\">\n      <span class=\"sc-tile-label\">Bills more than 15 days late</span>\n      <span class=\"sc-big dash-skeleton\" id=\"t-over15\" data-source=\"ap_status\" data-field=\"over15\" data-row=\"0\">\u2014</span>\n      <span class=\"sc-tile-note\">Target $0</span>\n      <span class=\"sc-pill\" id=\"p-over15\"></span>\n    </div>\n    <div class=\"sc-tile\">\n      <span class=\"sc-tile-label\">Open POs not yet received</span>\n      <span class=\"sc-big dash-skeleton\" id=\"t-po\" data-source=\"open_po_total\" data-field=\"total\" data-row=\"0\">\u2014</span>\n      <span class=\"sc-tile-note\">Becomes bills when it lands. Push out what we don't need yet</span>\n    </div>\n    <div class=\"sc-tile\">\n      <span class=\"sc-tile-label\">Credit cards owed</span>\n      <span class=\"sc-big dash-skeleton\" id=\"t-cards\" data-source=\"cash_cards\" data-field=\"cards\" data-row=\"0\">\u2014</span>\n      <span class=\"sc-tile-note\">MC and Amex</span>\n    </div>\n  </section>\n\n  <section class=\"sc-sec\" id=\"sales\">\n    <h2 class=\"sc-sec-h\">Sales <span>\u00b7 Daro</span></h2>\n    <div class=\"sc-grid\">\n      <div class=\"sc-card\">\n        <h3 id=\"sales-chart-h\">Sales by week</h3>\n        <p class=\"sc-note\">Invoices and cash sales, less credits. Dashed line is the $97K target. The lighter bar is the week in progress.</p>\n        <div class=\"sc-chart dash-skeleton\" id=\"sales-chart\" data-source=\"sales_weekly\"></div>\n        <div class=\"sc-stats\" id=\"plan-stats\">\n          <div class=\"sc-stat\"><b class=\"dash-skeleton\" data-source=\"sales_status\" data-field=\"plan_sales\" data-row=\"0\">\u2014</b><span>Sold since Oct 26</span></div>\n          <div class=\"sc-stat\"><b class=\"dash-skeleton\" data-source=\"sales_status\" data-field=\"plan_target\" data-row=\"0\">\u2014</b><span>Target since Oct 26</span></div>\n          <div class=\"sc-stat\"><b class=\"dash-skeleton\" id=\"plan-gap\" data-source=\"sales_status\" data-field=\"plan_gap\" data-row=\"0\">\u2014</b><span>Ahead or behind</span></div>\n        </div>\n      </div>\n      <div class=\"sc-card\">\n        <h3 id=\"quotes-chart-h\">Quotes sent by week</h3>\n        <p class=\"sc-note\">NetSuite estimates. Hover a week for won, lost, still open, and the win rate on decided quotes. Target: answer every quote within 24 hours, win 50% or better.</p>\n        <div class=\"sc-chart dash-skeleton\" id=\"quotes-chart\" data-source=\"quotes_weekly\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"sc-sec\" id=\"purchasing\">\n    <h2 class=\"sc-sec-h\">Purchasing and inventory <span>\u00b7 Darion</span></h2>\n    <div class=\"sc-grid\">\n      <div class=\"sc-card\">\n        <h3 id=\"pos-chart-h\">Purchase orders written by week</h3>\n        <p class=\"sc-note\">All POs, including buy-to-order. From Oct 26 on, new stock buys should be $0. Only orders backed by a customer order.</p>\n        <div class=\"sc-chart dash-skeleton\" id=\"pos-chart\" data-source=\"pos_weekly\"></div>\n      </div>\n      <div class=\"sc-card\">\n        <h3 id=\"openpo-h\">Open POs by vendor</h3>\n        <p class=\"sc-note\">Dollars ordered but not received yet. Keep what fills a backorder or real stockout, push the rest past January.</p>\n        <div class=\"sc-tablebox\">\n          <table class=\"sc-table\" id=\"openpo-table\" data-source=\"open_pos_vendor\" data-row-key=\"vendor\">\n            <thead><tr><th data-field=\"vendor\">Vendor</th><th data-field=\"pos\" class=\"num\">POs</th><th data-field=\"open_value\" class=\"num\">Not received</th><th aria-hidden=\"true\"></th></tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n    <div class=\"sc-tiles\">\n      <div class=\"sc-tile\">\n        <span class=\"sc-tile-label\">Items on backorder</span>\n        <span class=\"sc-big dash-skeleton\" data-source=\"backorders\" data-field=\"items_backordered\" data-row=\"0\">\u2014</span>\n        <span class=\"sc-tile-note\">Main warehouse. Should go down every week</span>\n      </div>\n      <div class=\"sc-tile\">\n        <span class=\"sc-tile-label\">Stock with no sales in 12 months</span>\n        <span class=\"sc-big dash-skeleton\" data-source=\"dead_stock\" data-field=\"dead_value\" data-row=\"0\">\u2014</span>\n        <span class=\"sc-tile-note\"><span class=\"dash-skeleton\" data-source=\"dead_stock\" data-field=\"dead_skus\" data-row=\"0\">\u2014</span> SKUs. Goal: $40K back as cash by Jan 31</span>\n      </div>\n      <div class=\"sc-tile\">\n        <span class=\"sc-tile-label\">Total inventory on hand</span>\n        <span class=\"sc-big dash-skeleton\" data-source=\"dead_stock\" data-field=\"total_value\" data-row=\"0\">\u2014</span>\n        <span class=\"sc-tile-note\">At cost</span>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"sc-sec\" id=\"operations\">\n    <h2 class=\"sc-sec-h\">Operations and shipping</h2>\n    <div class=\"sc-grid\">\n      <div class=\"sc-card\">\n        <h3 id=\"freight-chart-h\">Freight billed vs. freight cost</h3>\n        <p class=\"sc-note\">What we charge customers for shipping against what carriers charge us, including fuel surcharges. Cost should stay at or under billed.</p>\n        <div class=\"sc-legend\"><span><i class=\"sc-sw\" id=\"sw-billed\"></i>Billed to customers</span><span><i class=\"sc-sw\" id=\"sw-cost\"></i>Carrier cost</span></div>\n        <div class=\"sc-chart dash-skeleton\" id=\"freight-chart\" data-source=\"costs_weekly\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"sc-sec\" id=\"admin\">\n    <h2 class=\"sc-sec-h\">Administration and cash <span>\u00b7 Marty</span></h2>\n    <div class=\"sc-tiles\">\n      <div class=\"sc-tile\">\n        <span class=\"sc-tile-label\">Open vendor bills</span>\n        <span class=\"sc-big dash-skeleton\" data-source=\"ap_status\" data-field=\"open_ap\" data-row=\"0\">\u2014</span>\n        <span class=\"sc-tile-note\"><span class=\"dash-skeleton\" data-source=\"ap_status\" data-field=\"open_bills\" data-row=\"0\">\u2014</span> bills</span>\n      </div>\n      <div class=\"sc-tile\">\n        <span class=\"sc-tile-label\">Past due (any amount of days)</span>\n        <span class=\"sc-big dash-skeleton\" data-source=\"ap_status\" data-field=\"past_due\" data-row=\"0\">\u2014</span>\n        <span class=\"sc-tile-note\">Fine if under 15 days. Over 15 is the line</span>\n      </div>\n    </div>\n    <div class=\"sc-grid\">\n      <div class=\"sc-card\">\n        <h3 id=\"late-chart-h\">Late fees, penalties and interest by week</h3>\n        <p class=\"sc-note\">Account 71920. Target $0. This is money lost to paying late.</p>\n        <div class=\"sc-chart dash-skeleton\" id=\"late-chart\" data-source=\"costs_weekly\"></div>\n      </div>\n      <div class=\"sc-card\">\n        <h3 id=\"soft-chart-h\">Software spend by week</h3>\n        <p class=\"sc-note\">Account 66910. Goal: cut about $4K a month from what we were paying.</p>\n        <div class=\"sc-chart dash-skeleton\" id=\"soft-chart\" data-source=\"costs_weekly\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"sc-sec\" id=\"manual\">\n    <h2 class=\"sc-sec-h\">Tracked by hand for now</h2>\n    <div class=\"sc-card\">\n      <p class=\"sc-note\">These are on the weekly scorecard but aren't in NetSuite yet. Bring them to the Monday meeting.</p>\n      <ul class=\"sc-manual\">\n        <li>Top-account calls made (target 15 a week until all 66 are done) \u00b7 Daro</li>\n        <li>Win-back contacts to quiet customers (target 25 a week) \u00b7 Daro</li>\n        <li>HubSpot pipeline follow-ups on deals over $1,000 \u00b7 Daro</li>\n        <li>Orders shipped same day (target 95% or better) \u00b7 Operations</li>\n        <li>Dead stock cash recovered, running total (target $40K by Jan 31) \u00b7 Darion</li>\n        <li>Marketing emails sent (target 2 a month) and orders traced to them \u00b7 Marketing</li>\n        <li>Bookkeeping fixes done (payroll taxes, AP reconcile, loan accounts, monthly P&amp;L) \u00b7 Marty</li>\n      </ul>\n    </div>\n  </section>\n</div>\n\n<script>\ndash.calc('sales_status', {\n  title: 'Sales vs. $97K target',\n  description: 'Last full week and the week in progress, plus totals since the plan started on Oct 26 against $97K a week.',\n  inputs: ['sales_weekly'],\n  fn: (sales_weekly) => {\n    const rows = sales_weekly.map(r => ({ week: String(r.week), sales: Number(r.sales), current: Number(r.is_current) }));\n    const full = rows.filter(r => r.current === 0);\n    const cur = rows.find(r => r.current === 1);\n    const last = full[full.length - 1];\n    const plan = full.filter(r => r.week >= '2026-10-26');\n    const planSales = plan.reduce((s, r) => s + r.sales, 0);\n    return [{\n      last_week: last ? last.week : null,\n      last_sales: last ? last.sales : null,\n      last_gap: last ? last.sales - 97000 : null,\n      cur_week: cur ? cur.week : null,\n      cur_sales: cur ? cur.sales : 0,\n      plan_weeks: plan.length,\n      plan_sales: planSales,\n      plan_target: plan.length * 97000,\n      plan_gap: planSales - plan.length * 97000\n    }];\n  }\n});\n\ndash.calc('open_po_total', {\n  title: 'Open PO dollars, all vendors',\n  description: 'Sum of what is ordered but not yet received across every vendor.',\n  inputs: ['open_pos_vendor'],\n  fn: (open_pos_vendor) => [{\n    total: open_pos_vendor.reduce((s, r) => s + Number(r.open_value), 0),\n    pos: open_pos_vendor.reduce((s, r) => s + Number(r.pos), 0)\n  }]\n});\n</script>\n\n<script>\n(function () {\n  const money = d3.format('$,.0f');\n  const compact = new Intl.NumberFormat('en', { style: 'currency', currency: 'USD', notation: 'compact', maximumFractionDigits: 1 });\n  const big = v => Math.abs(v) >= 10000 ? compact.format(v) : money(v);\n  const signed = v => (v >= 0 ? '+' : '-') + big(Math.abs(v));\n  const count = d3.format(',');\n  const pct = d3.format('.0%');\n  const parseDay = d3.utcParse('%Y-%m-%d');\n  const dayFmt = d3.utcFormat('%b %-d');\n  const TARGET = 97000;\n\n  const marks = sel => Array.from(document.querySelectorAll(sel));\n  const setPill = (id, text, cls) => { const p = document.getElementById(id); p.className = 'sc-pill ' + (cls || ''); p.textContent = text || ''; };\n\n  function fillMarks(id, fmtByField) {\n    const d = dash.data(id);\n    marks('[data-source=\"' + id + '\"][data-field]').forEach(el => {\n      if (el.tagName === 'TH') return;\n      if (d.status !== 'ok') { if (d.status === 'loading') el.classList.add('dash-skeleton'); else { el.classList.remove('dash-skeleton'); el.textContent = '\u2014'; } return; }\n      el.classList.remove('dash-skeleton');\n      const rowIdx = Number(el.getAttribute('data-row') || 0);\n      const row = d.data[rowIdx];\n      const f = el.getAttribute('data-field');\n      if (!row || row[f] === null || row[f] === undefined) { el.textContent = '\u2014'; return; }\n      const fmt = (fmtByField && fmtByField[f]) || money;\n      el.textContent = fmt(Number(row[f]));\n    });\n  }\n\n  function chartState(el, st) {\n    if (st === 'ok') { el.classList.remove('dash-skeleton'); return true; }\n    el.innerHTML = '';\n    if (st === 'loading') { el.classList.add('dash-skeleton'); return false; }\n    el.classList.remove('dash-skeleton');\n    const f = document.createElement('div'); f.className = 'sc-fail'; f.textContent = 'Failed to load'; el.appendChild(f);\n    return false;\n  }\n\n  function bars(el, rows, cfg) {\n    el.innerHTML = '';\n    if (!rows.length) return;\n    const W = Math.max(280, el.clientWidth || 600), H = 220, mt = 14, mb = 24, mr = 8;\n    const fmtY = cfg.fmtY || big;\n    const maxV = d3.max(rows, r => d3.max(cfg.series, s => Number(r[s.key]) || 0)) || 0;\n    const y = d3.scaleLinear([0, Math.max(maxV, cfg.target || 0) * 1.08 || 1], [H - mb, mt]).nice();\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img');\n    const ticks = y.ticks(4);\n    const probe = svg.append('g');\n    ticks.forEach(t => probe.append('text').text(fmtY(t)));\n    const lw = d3.max(probe.selectAll('text').nodes(), n => n.getComputedTextLength()) || 30;\n    probe.remove();\n    const ml = Math.ceil(lw) + 10;\n    const x = d3.scaleBand(rows.map(r => r.week), [ml, W - mr]).padding(0.25);\n    const xi = d3.scaleBand(cfg.series.map(s => s.key), [0, x.bandwidth()]).padding(cfg.series.length > 1 ? 0.12 : 0);\n    const g = svg.append('g');\n    g.selectAll('line.grid').data(ticks).join('line').attr('x1', ml).attr('x2', W - mr).attr('y1', d => y(d)).attr('y2', d => y(d)).attr('stroke', 'var(--cds-chart-grid)').attr('stroke-width', 1);\n    g.selectAll('text.yl').data(ticks).join('text').attr('x', ml - 6).attr('y', d => y(d)).attr('dy', '0.32em').attr('text-anchor', 'end').text(d => fmtY(d));\n    const every = Math.max(1, Math.ceil(rows.length * 48 / (W - ml)));\n    g.selectAll('text.xl').data(rows.filter((r, i) => (rows.length - 1 - i) % every === 0)).join('text')\n      .attr('x', r => x(r.week) + x.bandwidth() / 2).attr('y', H - 6).attr('text-anchor', 'middle').text(r => dayFmt(parseDay(r.week)));\n    const bw = Math.min(32, xi.bandwidth());\n    cfg.series.forEach(s => {\n      g.selectAll(null).data(rows).join('rect')\n        .attr('x', r => x(r.week) + xi(s.key) + (xi.bandwidth() - bw) / 2)\n        .attr('width', bw)\n        .attr('y', r => y(Math.max(0, Number(r[s.key]) || 0)))\n        .attr('height', r => Math.max(0, y(0) - y(Math.max(0, Number(r[s.key]) || 0))))\n        .attr('rx', 4)\n        .attr('fill', s.color)\n        .attr('fill-opacity', r => (cfg.dim && cfg.dim(r)) ? 0.45 : 1);\n    });\n    g.append('line').attr('x1', ml).attr('x2', W - mr).attr('y1', y(0)).attr('y2', y(0)).attr('stroke', 'var(--cds-chart-axis)');\n    if (cfg.target) {\n      g.append('line').attr('x1', ml).attr('x2', W - mr).attr('y1', y(cfg.target)).attr('y2', y(cfg.target))\n        .attr('stroke', 'var(--cds-chart-reference)').attr('stroke-width', 1.5).attr('stroke-dasharray', '5 4');\n      g.append('text').attr('class', 'tl').attr('x', W - mr).attr('y', y(cfg.target) - 5).attr('text-anchor', 'end').text('Target ' + big(cfg.target));\n    }\n    const tip = d3.select(el).append('div').attr('class', 'sc-tip').style('display', 'none');\n    g.selectAll(null).data(rows).join('rect')\n      .attr('x', r => x(r.week) - x.step() * x.paddingInner() / 2).attr('width', x.step()).attr('y', mt).attr('height', H - mb - mt)\n      .attr('fill', 'transparent')\n      .on('mouseenter mousemove', (ev, r) => {\n        tip.style('display', null).html('');\n        tip.append('div').attr('class', 'd').text('Week of ' + dayFmt(parseDay(r.week)) + (cfg.dim && cfg.dim(r) ? ' (so far)' : ''));\n        cfg.tip(r).forEach(([label, value, color]) => {\n          const line = tip.append('div');\n          if (color) line.append('i').attr('class', 'sc-sw').style('background', color);\n          line.append('span').text(label + ': ' + value);\n        });\n        const box = el.getBoundingClientRect();\n        const tw = tip.node().offsetWidth;\n        let left = ev.clientX - box.left + 12;\n        if (left + tw > box.width) left = ev.clientX - box.left - tw - 12;\n        tip.style('left', Math.max(0, left) + 'px').style('top', Math.max(0, ev.clientY - box.top - 10) + 'px');\n      })\n      .on('mouseleave', () => tip.style('display', 'none'));\n  }\n\n  dash.onData(() => {\n    const c0 = dash.colors[0], c1 = dash.colors[1];\n    document.getElementById('sw-billed').style.background = c0;\n    document.getElementById('sw-cost').style.background = c1;\n\n    // Headline figures\n    fillMarks('sales_status', { last_gap: signed, plan_gap: signed });\n    fillMarks('cash_cards');\n    fillMarks('ap_status', { open_bills: count });\n    fillMarks('open_po_total');\n    fillMarks('backorders', { items_backordered: count });\n    fillMarks('dead_stock', { dead_skus: count });\n\n    const ss = dash.data('sales_status');\n    if (ss.status === 'ok' && ss.data[0]) {\n      const s = ss.data[0];\n      if (s.last_sales !== null) setPill('p-last', s.last_sales >= TARGET ? 'On target' : 'Under target', s.last_sales >= TARGET ? 'sc-ok' : 'sc-bad');\n      const gapEl = document.getElementById('plan-gap');\n      gapEl.className = s.plan_weeks === 0 ? '' : (s.plan_gap >= 0 ? 'sc-ok' : 'sc-bad');\n      if (s.plan_weeks === 0) gapEl.textContent = 'Starts Oct 26';\n    } else setPill('p-last', '');\n    const cc = dash.data('cash_cards');\n    if (cc.status === 'ok' && cc.data[0]) { const v = Number(cc.data[0].cash); setPill('p-cash', v >= 40000 ? 'Above floor' : (v >= 0 ? 'Below $40K floor' : 'Overdrawn'), v >= 40000 ? 'sc-ok' : (v >= 0 ? 'sc-warn' : 'sc-bad')); } else setPill('p-cash', '');\n    const ap = dash.data('ap_status');\n    if (ap.status === 'ok' && ap.data[0]) { const v = Number(ap.data[0].over15); setPill('p-over15', v <= 0 ? 'On target' : 'Pay these now', v <= 0 ? 'sc-ok' : 'sc-bad'); } else setPill('p-over15', '');\n\n    // Sales chart\n    const sw = dash.data('sales_weekly'), sEl = document.getElementById('sales-chart');\n    if (chartState(sEl, sw.status)) bars(sEl, sw.data, {\n      series: [{ key: 'sales', color: c0 }], target: TARGET,\n      dim: r => Number(r.is_current) === 1,\n      tip: r => [['Sales', money(Number(r.sales))], ['Invoices', count(Number(r.invoices))], ['Vs. target', signed(Number(r.sales) - TARGET)]]\n    });\n\n    // Quotes chart\n    const qw = dash.data('quotes_weekly'), qEl = document.getElementById('quotes-chart');\n    if (chartState(qEl, qw.status)) bars(qEl, qw.data, {\n      series: [{ key: 'quotes', color: c0 }], fmtY: d3.format(','),\n      tip: r => [['Quotes', count(Number(r.quotes))], ['Quoted value', money(Number(r.quote_value))], ['Won', count(Number(r.won))], ['Lost or expired', count(Number(r.lost))], ['Still open', count(Number(r.still_open))], ['Win rate (decided)', r.win_rate === null || r.win_rate === undefined ? 'none decided' : pct(Number(r.win_rate))]]\n    });\n\n    // POs chart\n    const pw = dash.data('pos_weekly'), pEl = document.getElementById('pos-chart');\n    if (chartState(pEl, pw.status)) bars(pEl, pw.data, {\n      series: [{ key: 'po_value', color: c0 }],\n      tip: r => [['PO dollars', money(Number(r.po_value))], ['POs written', count(Number(r.pos))]]\n    });\n\n    // Open PO table\n    const op = dash.data('open_pos_vendor'), tbody = document.querySelector('#openpo-table tbody');\n    tbody.innerHTML = '';\n    if (op.status === 'ok') {\n      const maxV = d3.max(op.data, r => Number(r.open_value)) || 1;\n      op.data.forEach(r => {\n        const tr = document.createElement('tr');\n        const td = (t, cls) => { const c = document.createElement('td'); if (cls) c.className = cls; c.textContent = t; tr.appendChild(c); return c; };\n        td(String(r.vendor));\n        td(count(Number(r.pos)), 'num');\n        td(money(Number(r.open_value)), 'num');\n        const bc = td('', ''); bc.style.width = '28%';\n        const b = document.createElement('div'); b.className = 'sc-bar'; b.style.width = (100 * Number(r.open_value) / maxV) + '%'; bc.appendChild(b);\n        tbody.appendChild(tr);\n      });\n    } else if (op.status !== 'loading') {\n      const tr = document.createElement('tr'); const c = document.createElement('td'); c.colSpan = 4; c.className = 'sc-fail'; c.textContent = 'Failed to load'; tr.appendChild(c); tbody.appendChild(tr);\n    }\n\n    // Costs charts\n    const cw = dash.data('costs_weekly');\n    const fEl = document.getElementById('freight-chart'), lEl = document.getElementById('late-chart'), sfEl = document.getElementById('soft-chart');\n    if (chartState(fEl, cw.status)) bars(fEl, cw.data, {\n      series: [{ key: 'freight_billed', color: c0 }, { key: 'freight_cost', color: c1 }],\n      tip: r => [['Billed', money(Number(r.freight_billed)), c0], ['Cost', money(Number(r.freight_cost)), c1], ['Cost vs. billed', Number(r.freight_billed) > 0 ? pct(Number(r.freight_cost) / Number(r.freight_billed)) : 'none billed']]\n    });\n    if (chartState(lEl, cw.status)) bars(lEl, cw.data, {\n      series: [{ key: 'late_fees', color: 'var(--cds-chart-status-critical)' }],\n      tip: r => [['Late fees and interest', money(Number(r.late_fees))]]\n    });\n    if (chartState(sfEl, cw.status)) bars(sfEl, cw.data, {\n      series: [{ key: 'software', color: c0 }],\n      tip: r => [['Software', money(Number(r.software))]]\n    });\n  });\n\n  const named = document.getElementById(location.hash.slice(1));\n  if (named) named.scrollIntoView();\n})();\n</script>\n"}}]